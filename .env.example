# Puerto del servidor en producción (en desarrollo el API usa 4000 y Vite 5173)
PORT=3000
# Secreto para firmar las sesiones (cámbialo en producción)
SESSION_SECRET=cambia-este-secreto
# Teléfonos (formato E.164, separados por coma) con acceso al dashboard de administración
ADMIN_PHONES=+5215555555555

# --- Envío de códigos por WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente de WhatsApp habilitado en Twilio, p. ej. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# --- Envío de códigos por correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Ángel Eterno <hola@angeleterno.com>"
